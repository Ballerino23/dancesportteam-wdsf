{
  "version": 2,
  "env": {
    "WDSF_URL": "https://www.worlddancesport.org"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(?!api).*",
      "dest": "/index.html"
    }
  ]
}
